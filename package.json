{
  "name": "live-sports-dashboard",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "bash ./run-live-stack.sh",
    "hydrate": "bash ./hydrate-feed.sh",
    "hydrate:git": "bash ./hydrate-feed.sh --git-sync",
    "hydrate:watch": "bash ./hydrate-feed.sh --watch --interval 900",
    "hydrate:watch:git": "bash ./hydrate-feed.sh --watch --interval 900 --git-sync",
    "frontend:dev": "node frontend/node_modules/vite/bin/vite.js --host 0.0.0.0",
    "frontend:build": "npm --prefix frontend run build",
    "backend:check": "node --check backend/scripts/scrape-soccer-games-today.js"
  }
}
